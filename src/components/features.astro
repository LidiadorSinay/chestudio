
---
import featuresData from "../../public/data/features.json";
import Link from "./ui/link.astro";

interface Feature {
  title: string;
  description?: string;
  icon?: string;
  astroIcon?: string;
  href?: string;
  url?: string;
  link?: string;
}

const features: Feature[] = featuresData;

const rutasServicios = {
  salud: "/servicios/salud",
  recuperacion: "/servicios/recuperacion-de-cuentas",
} as const;

const normalizar = (texto: string): string => {
  return texto
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .trim();
};

// Resolver íconos Material Symbols
const getIconName = (item: Feature): string => {
  const icono = item.icon?.trim() || "";

  // Compatibilidad con el nombre anterior
  if (
    icono === "account-reactivate" ||
    icono === "account-reactivate-outline" ||
    icono === "account-check-outline"
  ) {
    return "manage_accounts";
  }

  // Compatibilidad con datos anteriores
  if (!icono && item.astroIcon?.startsWith("mdi:")) {
    if (normalizar(item.title).includes("recuperacion")) {
      return "manage_accounts";
    }
  }

  return icono;
};

const getHref = (item: Feature): string | null => {
  const enlace = item.href || item.url || item.link;

  if (typeof enlace === "string" && enlace.trim()) {
    return enlace.trim();
  }

  const titulo = normalizar(item.title);

  if (
    titulo.includes("recuperacion") &&
    titulo.includes("cuenta")
  ) {
    return rutasServicios.recuperacion;
  }

  if (
    titulo === "salud" ||
    titulo.includes("derecho a la salud") ||
    titulo.includes("obras sociales") ||
    titulo.includes("medicina prepaga")
  ) {
    return rutasServicios.salud;
  }

  return null;
};
---

<style>
  section {
    background-color: var(--color-celeste-light);
  }

  h2,
  h3 {
    font-family: "Literata", serif;
  }

  h2 {
    font-size: 2.5rem;
    font-weight: 400;
  }

  h4 {
    padding-bottom: 4vh;
  }

  .material-symbols-outlined {
    font-family: "Material Symbols Outlined";
    font-weight: normal;
    font-style: normal;
    font-size: 2.5rem;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    font-feature-settings: "liga";
    -webkit-font-feature-settings: "liga";
    -webkit-font-smoothing: antialiased;
    color: #1f3a5f;
  }

  .pill2 {
    box-sizing: border-box;
    background-color: transparent;
    border: 2px solid #1f3a5f;
    border-radius: 4rem;
    font-weight: 600;
    padding: 1.25rem 2.5rem;
    transition: all 0.5s ease-in-out;
    color: #1f3a5f;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .pill2:hover {
    background-color: var(--color-azul-accent);
    box-shadow: 0 5px 15px #fff;
    color: #fff;
  }

  .feature-link {
    margin-top: 1.25rem;
    padding: 0.65rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .feature-link:hover {
    transform: translateY(-2px);
  }
</style>

<section id="servicios" class="px-5 py-20 text-aa">
  <div class="mt-16 md:mt-0 text-center">
    <h2 class="text-3xl lg:text-3xl lg:tracking-tight">
      Servicios
    </h2>

    <h4 class="text-lg mt-4 text-balance">
      Nos desempeñamos en las siguientes áreas
    </h4>

    <Link
      id="button"
      href="/servicios"
      class="pill2"
    >
      Ver más
    </Link>
  </div>

  <div
    class="grid md:grid-cols-2 mx-auto mt-16 gap-y-8 gap-x-5 max-w-5xl justify-items-center"
  >
    {features.map((item: Feature) => {
      const href = getHref(item);
      const iconName = getIconName(item);

      return (
        <div class="flex gap-4 items-start w-full">
          {/* Ícono Material Symbols */}
          <div class="bg-c rounded-full p-5 w-20 h-20 grid place-content-center shrink-0">
            {iconName && (
              <span
                class="material-symbols-outlined"
                aria-hidden="true"
              >
                {iconName}
              </span>
            )}
          </div>

          {/* Información del servicio */}
          <div class="max-w-xs flex flex-col items-start">
            <h3 class="font-semibold text-lg">
              {item.title}
            </h3>

            <p class="font-light mt-2 leading-relaxed">
              {item.description}
            </p>

            {href && (
              <Link
                href={href}
                class="pill2 feature-link"
              >
                Ver más
              </Link>
            )}
          </div>
        </div>
      );
    })}
  </div>
</section>
