---
import Layout from "../../layouts/Layout.astro";
import Navbarlight from "@components/navbar/navbarlight.astro";
import Container from "@components/container.astro";
import Wh from "@components/wh.astro";

import serviciosData from "../../../public/data/servicios-detalle.json";
import "../../style/servicio-detalle.css";

const servicio = serviciosData.find((item) => item.slug === "salud");

if (!servicio) {
  throw new Error("No se encontró el servicio Salud");
}

const seo = {
  title: `${servicio.title} | CHESTUDIO`,
  description: servicio.intro,
  canonical: new URL("/servicios/salud", Astro.site).toString(),
};
---

<Layout title={servicio.title} seo={seo}>
  <Navbarlight />

  <main class="pagina-servicio">

   <section class="hero-servicio hero-salud">
  <div class="hero-overlay"></div>

  <Container class="hero-container">
    <div class="hero-contenido">
      <span class="hero-categoria">SALUD</span>

      <div class="hero-linea"></div>

      <h1>
        Tu derecho a la salud<br />
        tiene respaldo
      </h1>

      <p>
        Asesoramiento jurídico para acceder a la cobertura,<br />
        los tratamientos y las prestaciones que te corresponden.
      </p>
    </div>
  </Container>
</section>

    <section class="contenido-servicio">
      <Container>

        <header class="introduccion-servicio">
  <h2>{servicio.introTitle}</h2>

  <p>{servicio.intro}</p>

  <div class="intro-linea"></div>
</header>

       <div class="productos-servicio">
  {
    servicio.productos.map((producto, index) => (
      <article
        class:list={[
          "producto",
          {
            "producto-con-video": producto.video,
            "producto-sin-video": !producto.video
          }
        ]}
      >
        <div class="producto-contenido">

          <div class="producto-encabezado">

            <div class="producto-icono">
              {
                index === 0 && (
                  <span class="material-symbols-outlined">
                    medication
                  </span>
                )
              }

              {
                index === 1 && (
                  <span class="material-symbols-outlined">
                    health_and_safety
                  </span>
                )
              }

              {
                index === 2 && (
                  <span class="material-symbols-outlined">
                    accessible
                  </span>
                )
              }

              {
                index === 3 && (
                  <span class="material-symbols-outlined">
                    elderly
                  </span>
                )
              }
            </div>

            <div class="producto-titulo">
              <h2>{producto.title}</h2>
              <div class="producto-linea"></div>
            </div>

          </div>

          <div class="producto-cuerpo">

            <p class="producto-subtitulo">
              {producto.subtitle}
            </p>

            <p class="producto-descripcion">
              {producto.description}
            </p>

            <ul>
              {
                producto.items.map((item) => (
                  <li>
                    <span class="check">
                      <span class="material-symbols-outlined">
                        check
                      </span>
                    </span>

                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>

            <a href="/#contacto" class="conocer-mas">
              <span>Conocer más</span>
              <span
                class="material-symbols-outlined flecha"
                aria-hidden="true"
              >
                arrow_forward
              </span>
            </a>

          </div>
        </div>

        {
          producto.video && (
            <div class="producto-video">
              <video
                src={producto.video}
                controls
                preload="metadata"
                playsinline
              />
            </div>
          )
        }
      </article>
    ))
  }
</div>

      </Container>
    </section>

  </main>

  <Wh phone="5491171387291" />
</Layout>

  <Wh phone="5491171387291" />
</Layout>